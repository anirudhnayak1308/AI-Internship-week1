OPENAI_API_KEY=

# Embeddings - keep this identical at ingest time and query time
EMBEDDING_MODEL=text-embedding-3-small

# Pinecone (vector store)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# /ingest chunking (RecursiveCharacterTextSplitter)
CHUNK_SIZE=800
CHUNK_OVERLAP=100
